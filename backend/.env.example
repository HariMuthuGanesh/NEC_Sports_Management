# ==========================================
# NEC Sports Management Backend - Environment Variables
# ==========================================

NODE_ENV=production
PORT=5000

# Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here
COOKIE_SECRET=your_super_secret_cookie_key_here
CSRF_SECRET=your_super_secret_csrf_key_here

# Frontend Client URL for CORS (Comma-separated if multiple)
CLIENT_URL=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Database Option A: Cloud MySQL Connection URI (e.g. Railway, PlanetScale, Aiven, Supabase, TiDB)
# DATABASE_URL=mysql://user:password@host:port/database

# Database Option B: Discrete Parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=nec_sports_db
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# Optional Email / Notification Service (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sports@nec.edu.in
# SMTP_PASS=your_app_password

# ==========================================
# OAuth 2.0 Identity Providers
# ==========================================

# Base URL of the backend (needed for OAuth callbacks)
# Default: http://localhost:5000
# Production: https://api.yourdomain.com
BASE_URL=http://localhost:5000

# Microsoft Entra ID (Azure AD) - For College Official Email
# Provider ID: microsoft
OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
OAUTH_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0

# Google Workspace - For alternative logins
# Provider ID: google
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GOOGLE_ISSUER=https://accounts.google.com
