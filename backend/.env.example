# NEC Sports Management Backend — Environment Configuration
PORT=8000
NODE_ENV=development

# 256-bit Cryptographic Secret for JWT Session Signatures (Minimum 32 characters)
JWT_SECRET=nec_sports_super_secure_jwt_secret_key_2026_production_safe_token_32chars

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/nec_sports_db

# CORS Allowed Client URL
CLIENT_URL=http://localhost:5173
